<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.DriverApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#000000</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <item name="android:windowBackground">#F7F8FA</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#121212</item>

        <item name="textAppearanceTitleLarge">@style/UberTitleStyle</item>

        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFF</item>

        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="UberTitleStyle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="Theme.DriverApp" parent="Base.Theme.DriverApp" />

</resources>