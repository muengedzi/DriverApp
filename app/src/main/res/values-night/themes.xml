<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark Mode Theme (Material 3) -->
    <style name="Base.Theme.DriverApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary Colors (Brighter for dark mode visibility) -->
        <item name="colorPrimary">#81C784</item>
        <item name="colorOnPrimary">#00390A</item>
        <item name="colorPrimaryContainer">#005313</item>
        <item name="colorOnPrimaryContainer">#9DFF9C</item>

        <!-- Secondary Colors -->
        <item name="colorSecondary">#BACCB3</item>
        <item name="colorOnSecondary">#253423</item>

        <!-- Background/Surface (True Dark Gray) -->
        <item name="android:windowBackground">#1A1C19</item>
        <item name="colorSurface">#1A1C19</item>
        <item name="colorOnSurface">#E2E3DD</item>

        <!-- Error -->
        <item name="colorError">#FFB4AB</item>
        <item name="colorOnError">#690005</item>

        <!-- Status bar and navigation -->
        <item name="android:statusBarColor">#1A1C19</item>
        <item name="android:navigationBarColor">#1A1C19</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
