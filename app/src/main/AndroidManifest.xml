<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions for both driver and customer features -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DriverApp"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- Common Login Activity (Shared by all apps) -->
        <activity
            android:name="com.broadbandlifestyle.common.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Driver App Activities -->
        <activity
            android:name="com.broadbandlifestyle.driverapp.MainActivity"
            android:exported="false"
            android:label="Driver Dashboard"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.broadbandlifestyle.driverapp.ProfileActivity"
            android:exported="false"
            android:label="My Profile"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.broadbandlifestyle.driverapp.EarningsActivity"
            android:exported="false"
            android:label="My Earnings"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.broadbandlifestyle.driverapp.HistoryActivity"
            android:exported="false"
            android:label="Order History"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.broadbandlifestyle.driverapp.RegisterActivity"
            android:exported="false" />

        <activity
            android:name="com.broadbandlifestyle.driverapp.ForgotPasswordActivity"
            android:exported="false" />

        <!-- Customer App Activities -->
        <activity
            android:name="com.broadbandlifestyle.customerapp.ShopActivity"
            android:exported="false"
            android:label="Premium Shop"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.broadbandlifestyle.customerapp.CartActivity"
            android:exported="false"
            android:label="Your Cart"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.broadbandlifestyle.customerapp.CheckoutActivity"
            android:exported="false"
            android:label="Checkout"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.broadbandlifestyle.customerapp.OrderSuccessActivity"
            android:exported="false"
            android:label="Order Success"
            android:screenOrientation="portrait" />

        <!-- Restaurant App Activities -->
        <activity
            android:name="com.broadbandlifestyle.restaurantapp.RestaurantDashboardActivity"
            android:exported="false"
            android:label="Restaurant Dashboard"
            android:screenOrientation="portrait"
            android:parentActivityName="com.broadbandlifestyle.common.LoginActivity" />

        <activity
            android:name="com.broadbandlifestyle.restaurantapp.OrderDetailActivity"
            android:exported="false"
            android:label="Order Details"
            android:screenOrientation="portrait"
            android:parentActivityName="com.broadbandlifestyle.restaurantapp.RestaurantDashboardActivity" />

        <!-- Foreground Service for Driver Location Tracking -->
        <service
            android:name="com.broadbandlifestyle.driverapp.OrderForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

    </application>

</manifest>